cabal-version:      3.0
name:               semantic-categorical-oracle
version:            0.1.0.0
synopsis:           Non-authoritative semantic and categorical oracle
license:            BSD-3-Clause
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Werror=incomplete-patterns
  default-language: GHC2021

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
      Oracle.Category
      Oracle.Result
      Oracle.SpruceGoose.DeploymentLifecycle
  build-depends:
      base >=4.17 && <5

executable semantic-categorical-oracle
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >=4.17 && <5,
      semantic-categorical-oracle

test-suite laws
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
      base >=4.17 && <5,
      QuickCheck >=2.14 && <2.16,
      semantic-categorical-oracle
