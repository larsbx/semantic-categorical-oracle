cabal-version:      3.0
name:               semantic-categorical-oracle
version:            0.1.0.0
synopsis:           Scoped semantic and categorical oracle
license:            BSD-3-Clause
build-type:         Simple
data-files:
    fixtures/proof-graph/*.json

common warnings
  ghc-options: -Wall -Wcompat -Werror=incomplete-patterns
  default-language: GHC2021

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
      Oracle.Category
      Oracle.Concept.Assertion
      Oracle.Concept.Filter
      Oracle.Concept.Relation
      Oracle.Concept.Validate
      Oracle.GrowthBridge
      Oracle.ProofGraph
      Oracle.Result
      Oracle.Usul.Argumentation
      Oracle.Usul.Hukm
      Oracle.Usul.Qiyas
      Oracle.Usul.Sadi
      Oracle.Usul.Schema
      Oracle.Usul.Taarud
  build-depends:
      base >=4.17 && <5,
      aeson >=2.1 && <2.3,
      bytestring >=0.11 && <0.13,
      text >=2.0 && <2.2,
      vector >=0.13 && <0.14

executable semantic-categorical-oracle
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >=4.17 && <5,
      semantic-categorical-oracle

executable concept-filter
  import: warnings
  hs-source-dirs: cli
  main-is: Main.hs
  build-depends:
      base >=4.17 && <5,
      aeson >=2.1 && <2.3,
      bytestring >=0.11 && <0.13,
      semantic-categorical-oracle

test-suite laws
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
      Concept.Laws
      Usul.GroundedVectors
      Usul.Laws
  build-depends:
      base >=4.17 && <5,
      bytestring >=0.11 && <0.13,
      QuickCheck >=2.14 && <2.16,
      semantic-categorical-oracle
