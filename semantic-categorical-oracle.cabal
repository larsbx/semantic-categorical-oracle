cabal-version:      3.0
name:               semantic-categorical-oracle
version:            0.1.0.0
synopsis:           Scoped semantic contracts and advisory categorical oracles
license:            BSD-3-Clause
build-type:         Simple
extra-source-files:
    test-vectors/finite-proof-graph/minimal-v1.input.json
    test-vectors/finite-proof-graph/minimal-v1.expected.json

common warnings
  ghc-options: -Wall -Wcompat -Werror=incomplete-patterns
  default-language: GHC2021

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
      Oracle.Category
      Oracle.ProofGraph
      Oracle.Result
  build-depends:
      aeson >=2.1 && <2.3,
      base >=4.17 && <5,
      containers >=0.6 && <0.8,
      text >=2.0 && <2.2,
      vector >=0.13 && <0.14

executable semantic-categorical-oracle
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >=4.17 && <5,
      semantic-categorical-oracle

test-suite laws
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
      base >=4.17 && <5,
      aeson >=2.1 && <2.3,
      bytestring >=0.11 && <0.13,
      QuickCheck >=2.14 && <2.16,
      semantic-categorical-oracle
